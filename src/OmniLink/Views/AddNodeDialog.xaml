<Window x:Class="OmniLink.Views.AddNodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Add Node Manually"
        Width="480" Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource FluentCanvasBrush}"
            BorderBrush="{StaticResource FluentBorderHoverBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24"
                               Foreground="{StaticResource FluentAccentLightBrush}"
                               FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.dialog.add.title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Loc.dialog.add.subtitle}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Loc.dialog.add.ip}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,5"/>
                <TextBox x:Name="IpBox" Style="{StaticResource FluentCompactTextBox}" MinHeight="34" FontSize="13" Padding="10,6"/>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Loc.dialog.add.port}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <TextBox x:Name="PortBox" Text="24801" Style="{StaticResource FluentCompactTextBox}" MinHeight="34" FontSize="13" Padding="10,6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Loc.dialog.add.position}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="PositionCombo" MinHeight="34" FontSize="13" SelectedIndex="0">
                            <ComboBoxItem Content="{DynamicResource Loc.dialog.add.pos.right}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.dialog.add.pos.left}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.dialog.add.pos.top}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.dialog.add.pos.bottom}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource Loc.dialog.add.name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,5"/>
                <TextBox x:Name="NameBox" Style="{StaticResource FluentCompactTextBox}" MinHeight="34" FontSize="13" Padding="10,6"/>

                <TextBlock Text="{DynamicResource Loc.dialog.add.pin}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,5"/>
                <TextBox x:Name="PinBox" Style="{StaticResource FluentCompactTextBox}" MinHeight="34" FontSize="13" Padding="10,6"/>

                <TextBlock x:Name="FeedbackText" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Action Buttons -->
            <DockPanel Grid.Row="2" Margin="0,14,0,0">
                <Button Content="{DynamicResource Loc.common.cancel}"
                        Style="{StaticResource AppleSecondaryButton}"
                        Padding="14,5" MinHeight="32" FontSize="11.5"
                        Click="OnCancelClick"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnPair"
                            Content="{DynamicResource Loc.settings.pairing.pair}"
                            Style="{StaticResource ApplePrimaryButton}"
                            Padding="16,5" MinHeight="32" FontSize="11.5"
                            Click="OnPairClick"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
