<Window x:Class="OmniLink.Views.HotkeyEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Border CornerRadius="10" Background="{DynamicResource FluentCardBrush}" BorderBrush="{DynamicResource FluentBorderSubtleBrush}" BorderThickness="1" Padding="20,16">
        <StackPanel>
            <TextBlock Text="{DynamicResource Loc.hotkey.editor.title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
            <TextBlock Text="{DynamicResource Loc.hotkey.editor.subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>

            <!-- Key capture -->
            <TextBlock Text="{DynamicResource Loc.hotkey.editor.key}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="KeyBox" IsReadOnly="True" MinHeight="36" FontSize="14" FontWeight="Bold" HorizontalContentAlignment="Center"
                     CaretBrush="Transparent" Background="{DynamicResource FluentCardDeepBrush}" Foreground="{DynamicResource FluentAccentLightBrush}"
                     BorderBrush="{DynamicResource FluentBorderFocusedBrush}" PreviewKeyDown="OnKeyCapture"/>
            <TextBlock x:Name="KeyErrorText" Style="{StaticResource SettingError}" Visibility="Collapsed" Margin="0,4,0,0"/>
            <TextBlock Text="{DynamicResource Loc.hotkey.editor.key.tip}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,12"/>

            <!-- Action builder -->
            <TextBlock Text="{DynamicResource Loc.hotkey.editor.action}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="{DynamicResource Loc.hotkey.editor.action.add}" Style="{StaticResource AppleSecondaryButton}" Padding="10,3" MinHeight="28" Click="OnAddActionClick"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ActionTypeCombo" Width="210" MinHeight="30" FontSize="12" VerticalContentAlignment="Center" SelectionChanged="OnActionTypeChanged"/>
                    <ComboBox x:Name="NodeCombo" Width="180" MinHeight="30" FontSize="12" VerticalContentAlignment="Center" Margin="8,0,8,0" Visibility="Collapsed"
                              DisplayMemberPath="Display"/>
                </StackPanel>
            </DockPanel>

            <ListBox x:Name="ActionList" MinHeight="52" MaxHeight="120" Background="{DynamicResource FluentCardDeepBrush}"
                     BorderBrush="{DynamicResource FluentBorderSubtleBrush}" BorderThickness="1" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="8,4">
                            <Button DockPanel.Dock="Right" Content="✕" Background="Transparent" BorderThickness="0" Padding="4,0"
                                    Foreground="{DynamicResource StatusErrorBrush}" Cursor="Hand" Click="OnRemoveActionClick" Tag="{Binding}"/>
                            <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="ConflictText" Style="{StaticResource SettingError}" Visibility="Collapsed" Margin="0,6,0,0"/>

            <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="{DynamicResource Loc.common.save}" Style="{StaticResource ApplePrimaryButton}" Padding="16,5" MinHeight="32" Click="OnSaveClick"/>
                <Button Content="{DynamicResource Loc.common.cancel}" Style="{StaticResource AppleSecondaryButton}" Padding="14,5" MinHeight="32" Click="OnCancelClick"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
