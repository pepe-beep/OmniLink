<UserControl x:Class="OmniLink.Views.Settings.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Loc.settings.network}" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
        <TextBlock Text="{DynamicResource Loc.settings.network.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.settings.ports.title}" Style="{StaticResource SettingTitle}" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Loc.settings.ports.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>

                <WrapPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.ports.tcp}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="KvmTcpPortBox" Style="{StaticResource SettingBox}" TextChanged="OnPortChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.ports.udp}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="KvmUdpPortBox" Style="{StaticResource SettingBox}" TextChanged="OnPortChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.ports.disc}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="DiscoveryPortBox" Style="{StaticResource SettingBox}" TextChanged="OnPortChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.ports.rtp}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="PlaybackRtpPortBox" Style="{StaticResource SettingBox}" TextChanged="OnPortChanged"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="PortErrorText" Style="{StaticResource SettingError}" Visibility="Collapsed" Margin="0,0,0,10"/>

                <TextBlock Text="{DynamicResource Loc.settings.allowlist.title}" Style="{StaticResource SettingTitle}" Margin="0,6,0,2"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Loc.settings.allowlist.desc}" Style="{StaticResource SettingDesc}"/>
                    <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.allowlist.tip}">
                        <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                    </Button>
                </StackPanel>
                <TextBox x:Name="AllowlistBox" MinHeight="56" Margin="0,6,0,4" FontSize="11.5"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource FluentCardDeepBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                         BorderBrush="{DynamicResource FluentBorderSubtleBrush}" TextChanged="OnAllowlistChanged"/>
                <TextBlock x:Name="AllowlistErrorText" Style="{StaticResource SettingError}" Visibility="Collapsed"/>

                <!-- v1.9: กล่องเดิมแสดง "คำสั่งติดตั้ง" ที่ไม่เคยมีโค้ด populate (กล่องว่างเปล่า) — เปลี่ยนเป็นข้อความชี้ทางจริง -->
                <Border CornerRadius="6" Padding="12,8" Background="{DynamicResource FluentCardDeepBrush}" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.ports.deploy.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                        <TextBlock Text="{DynamicResource Loc.settings.ports.deploy}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
