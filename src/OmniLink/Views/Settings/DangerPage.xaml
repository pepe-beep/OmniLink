<UserControl x:Class="OmniLink.Views.Settings.DangerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Loc.settings.danger}" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource StatusErrorBrush}" Margin="0,0,0,2"/>
        <TextBlock Text="{DynamicResource Loc.settings.danger.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

        <Border Style="{StaticResource SettingsCardStyle}" BorderBrush="{DynamicResource StatusErrorBrush}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.settings.danger.warn.title}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource StatusErrorBrush}" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Loc.settings.danger.warn.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,12"/>

                <Button Content="{DynamicResource Loc.settings.danger.pairings}" HorizontalAlignment="Left" Padding="14,6" MinHeight="34"
                        Background="Transparent" Foreground="{DynamicResource StatusWarningBrush}" BorderBrush="{DynamicResource StatusWarningBrush}"
                        Click="OnClearPairingsClick" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource Loc.settings.danger.pairings.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

                <Button Content="{DynamicResource Loc.settings.danger.allowlist}" HorizontalAlignment="Left" Padding="14,6" MinHeight="34"
                        Background="Transparent" Foreground="{DynamicResource StatusWarningBrush}" BorderBrush="{DynamicResource StatusWarningBrush}"
                        Click="OnClearAllowlistClick" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource Loc.settings.danger.allowlist.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

                <Button Content="{DynamicResource Loc.settings.danger.factory}" HorizontalAlignment="Left" Padding="14,6" MinHeight="34"
                        Background="{DynamicResource StatusErrorBgBrush}" Foreground="{DynamicResource StatusErrorBrush}" BorderBrush="{DynamicResource StatusErrorBrush}"
                        Click="OnFactoryResetClick" Margin="0,0,0,10"/>
                <TextBlock Text="{DynamicResource Loc.settings.danger.factory.desc}" Style="{StaticResource SettingDesc}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
