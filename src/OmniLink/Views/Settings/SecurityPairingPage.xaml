<UserControl x:Class="OmniLink.Views.Settings.SecurityPairingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Loc.settings.security}" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
        <TextBlock Text="{DynamicResource Loc.settings.security.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

        <!-- Discovery & Pairing -->
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnAddManually" Content="{DynamicResource Loc.settings.pairing.manual}"
                                Background="Transparent" BorderBrush="{DynamicResource FluentBorderSubtleBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                Padding="12,5" MinHeight="28" FontSize="11.5" Margin="0,0,8,0"
                                ToolTip="{DynamicResource Loc.settings.pairing.manual.tip}" Click="OnAddNodeManuallyClick"/>
                        <Button x:Name="BtnScanNetwork" Content="{DynamicResource Loc.settings.pairing.scan}"
                                Background="{DynamicResource FluentAccentPrimaryBrush}" Foreground="White" BorderThickness="0"
                                Padding="12,5" MinHeight="28" FontSize="11.5" Click="OnScanNetworkClick"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.settings.pairing.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock x:Name="DiscoveryStatusText" Text="{DynamicResource Loc.settings.pairing.status.idle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </DockPanel>

                <TextBlock x:Name="DiscoveryCountText" Text="{DynamicResource Loc.settings.pairing.count0}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>

                <ListBox x:Name="DiscoveredNodesListBox" MinHeight="72" MaxHeight="132" Margin="0,0,0,12"
                         SelectionChanged="OnDiscoveredNodeSelectionChanged"
                         Background="{DynamicResource FluentCardDeepBrush}" BorderBrush="{DynamicResource FluentBorderSubtleBrush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="10,6">
                                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,2" VerticalAlignment="Center" Background="{Binding BadgeBg}">
                                    <TextBlock Text="{Binding BadgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding DetailLine}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border CornerRadius="6" Padding="12" Background="{DynamicResource FluentCardDeepBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="PairingTargetNodeLabel" Text="{DynamicResource Loc.settings.pairing.target.none}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="PairingFeedbackText" Text="{DynamicResource Loc.settings.pairing.hint}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" x:Name="PairingPinBox" Width="80" Height="28" Margin="10,0" VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center" FontSize="12" MaxLength="6" Text="1234"/>
                        <Button Grid.Column="2" x:Name="BtnPairDevice" Content="{DynamicResource Loc.settings.pairing.pair}" Style="{StaticResource ApplePrimaryButton}"
                                Padding="12,4" MinHeight="28" Click="OnPairDeviceClick"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- TLS Fingerprints of paired nodes -->
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <TextBlock Text="{DynamicResource Loc.settings.fp.title}" Style="{StaticResource SettingTitle}"/>
                    <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.fp.tip}">
                        <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                    </Button>
                </StackPanel>
                <TextBlock Text="{DynamicResource Loc.settings.fp.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                <ListBox x:Name="FingerprintList" MinHeight="60" HorizontalContentAlignment="Stretch"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <Button DockPanel.Dock="Right" Content="{DynamicResource Loc.settings.fp.revoke}"
                                        Background="Transparent" Foreground="{DynamicResource StatusErrorBrush}" BorderBrush="{DynamicResource StatusErrorBrush}"
                                        Padding="8,2" MinHeight="24" FontSize="10.5" VerticalAlignment="Center"
                                        ToolTip="{DynamicResource Loc.settings.fp.revoke.tip}" Click="OnRevokeFingerprintClick" Tag="{Binding}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Fingerprint}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="FpEmptyText" Text="{DynamicResource Loc.settings.fp.empty}" Style="{StaticResource SettingDesc}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Policy summary -->
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.settings.policy.title}" Style="{StaticResource SettingTitle}" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Loc.settings.policy.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,8"/>
                <TextBlock x:Name="PolicySummaryText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
