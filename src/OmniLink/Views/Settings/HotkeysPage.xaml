<UserControl x:Class="OmniLink.Views.Settings.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Loc.settings.hotkeys}" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
        <TextBlock Text="{DynamicResource Loc.settings.hotkeys.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" x:Name="BtnAddHotkey" Content="{DynamicResource Loc.hotkey.add}"
                            Background="{DynamicResource FluentAccentPrimaryBrush}" Foreground="White" BorderThickness="0"
                            Padding="12,5" MinHeight="28" FontSize="11.5" FontWeight="SemiBold" Click="OnAddClick"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.hotkey.list.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.hotkey.list.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <ListBox x:Name="RuleList" MinHeight="64" HorizontalContentAlignment="Stretch"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,3">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Loc.common.edit}" Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource FluentAccentLightBrush}" Padding="8,2" Cursor="Hand" FontSize="11"
                                            Click="OnEditClick" Tag="{Binding}"/>
                                    <Button Content="{DynamicResource Loc.devices.remove}" Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource StatusErrorBrush}" Padding="8,2" Cursor="Hand" FontSize="11"
                                            Click="OnRemoveClick" Tag="{Binding}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding KeyText}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ActionsText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="{DynamicResource Loc.hotkey.empty}" Style="{StaticResource SettingDesc}" Margin="0,2,0,0"/>

                <TextBlock x:Name="ConflictText" Style="{StaticResource SettingError}" Visibility="Collapsed" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
