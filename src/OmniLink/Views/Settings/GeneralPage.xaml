<UserControl x:Class="OmniLink.Views.Settings.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Loc.settings.general}" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
        <TextBlock Text="{DynamicResource Loc.settings.general.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>

                <!-- UI Language -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox x:Name="LangCombo" Style="{StaticResource SettingCombo}" SelectionChanged="OnLangChanged">
                            <ComboBoxItem Content="{DynamicResource Loc.settings.lang.auto}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.settings.lang.th}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.settings.lang.en}"/>
                        </ComboBox>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.lang.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.settings.lang.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.settings.lang.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Theme -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox x:Name="ThemeCombo" Width="170" MinHeight="32" FontSize="12" VerticalContentAlignment="Center"
                                  HorizontalAlignment="Right" SelectionChanged="OnThemeChanged">
                            <ComboBoxItem Content="{DynamicResource Loc.settings.theme.current}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.settings.theme.black}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.settings.theme.light}"/>
                        </ComboBox>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.theme.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.settings.theme.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.settings.theme.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Close button behavior -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox x:Name="CloseActionCombo" Width="190" MinHeight="32" FontSize="12" VerticalContentAlignment="Center"
                                  HorizontalAlignment="Right" SelectionChanged="OnCloseActionChanged">
                            <ComboBoxItem Content="{DynamicResource Loc.settings.close.tray}"/>
                            <ComboBoxItem Content="{DynamicResource Loc.settings.close.exit}"/>
                        </ComboBox>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.close.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.settings.close.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.settings.close.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Auto start KVM engine -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="ChkAutoStartKvm" VerticalAlignment="Center" Checked="OnAutoStartKvmChanged" Unchecked="OnAutoStartKvmChanged"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.settings.autokvm.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.settings.autokvm.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- v1.9 C4: กัน sleep -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="ChkPreventSleep" VerticalAlignment="Center" Checked="OnPreventSleepChanged" Unchecked="OnPreventSleepChanged"/>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.sleep.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.settings.sleep.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.settings.sleep.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- Keyboard layout sync -->
                <StackPanel Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Loc.settings.kbsync.title}" Style="{StaticResource SettingTitle}"/>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.kbsync.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Loc.settings.kbsync.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RadioTargetOnly" Content="{DynamicResource Loc.settings.kbsync.target}" FontSize="11.5"
                                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,14,0" Checked="OnKbSyncChanged"/>
                        <RadioButton x:Name="RadioGlobalCalibrated" Content="{DynamicResource Loc.settings.kbsync.all}" FontSize="11.5"
                                     Foreground="{DynamicResource TextSecondaryBrush}" Checked="OnKbSyncChanged"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Exit -->
        <DockPanel Margin="0,4,0,12">
            <Button DockPanel.Dock="Right" Content="{DynamicResource Loc.app.exit}" Style="{StaticResource AppleSecondaryButton}"
                    Padding="14,5" Click="OnExitClick"/>
            <TextBlock Text="{DynamicResource Loc.app.running.host}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
        </DockPanel>
    </StackPanel>
</UserControl>
