<UserControl x:Class="OmniLink.Views.Settings.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
            <TextBlock Text="{DynamicResource Loc.settings.advanced}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Border CornerRadius="8" Padding="6,2" Margin="10,0,0,0" Background="{DynamicResource StatusOnlineBgBrush}"
                    BorderBrush="{DynamicResource StatusOnlineBrush}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Loc.settings.advanced.badge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StatusOnlineBrush}"/>
            </Border>
        </StackPanel>
        <TextBlock Text="{DynamicResource Loc.settings.advanced.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

        <!-- Sub mode (v2.0 phase 3): ให้เครื่องนี้ถูกคุมโดย host เครื่องอื่น -->
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.sub.toggle.title}" Style="{StaticResource SettingTitle}" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Loc.sub.toggle.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <WrapPanel>
                    <CheckBox x:Name="ChkSubMode" Content="{DynamicResource Loc.sub.toggle.check}" Style="{StaticResource SettingCheck}" Checked="OnSubModeChanged" Unchecked="OnSubModeChanged"/>
                </WrapPanel>
                <TextBlock x:Name="SubModePinText" Text="" FontSize="10.5" Margin="2,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </Border>

        <!-- Resource & Low-Memory -->
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.settings.res.title}" Style="{StaticResource SettingTitle}" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Loc.settings.res.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <CheckBox x:Name="ChkLowMemoryMode" Content="{DynamicResource Loc.settings.res.lowmem}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    <CheckBox x:Name="ChkLowMemSoftwareRender" Content="{DynamicResource Loc.settings.res.software}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    <CheckBox x:Name="ChkLowMemThreadPool" Content="{DynamicResource Loc.settings.res.threadpool}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    <CheckBox x:Name="ChkLowMemGcBatch" Content="{DynamicResource Loc.settings.res.gcbatch}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                </WrapPanel>
                <TextBlock x:Name="LowMemStatusText" Text="" FontSize="10.5" Margin="2,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Audio pipeline deep tuning -->
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.settings.audiodeep.title}" Style="{StaticResource SettingTitle}" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Loc.settings.audiodeep.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.audiodeep.latency}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="PlaybackLatencyBox" Style="{StaticResource SettingBox}" TextChanged="OnBoxChanged"/>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.audiodeep.latency.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.audiodeep.buffer}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="UdpBufferBox" Style="{StaticResource SettingBox}" TextChanged="OnBoxChanged"/>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.audiodeep.buffer.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Heartbeat / ping intervals -->
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.settings.ping.title}" Style="{StaticResource SettingTitle}" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Loc.settings.ping.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <CheckBox x:Name="ChkAdaptivePing" Content="{DynamicResource Loc.settings.ping.adaptive}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.ping.active}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="PingActiveBox" Style="{StaticResource SettingBox}" TextChanged="OnBoxChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.ping.idle}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="PingIdleBox" Style="{StaticResource SettingBox}" TextChanged="OnBoxChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.ping.tray}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="PingTrayBox" Style="{StaticResource SettingBox}" TextChanged="OnBoxChanged"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Behavior toggles that were mislabeled/hidden before v1.9 -->
        <Border Style="{StaticResource SettingsCardStyle}">
            <StackPanel>
                <TextBlock Text="{DynamicResource Loc.settings.behavior.title}" Style="{StaticResource SettingTitle}" Margin="0,0,0,2"/>
                <TextBlock Text="{DynamicResource Loc.settings.behavior.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <CheckBox x:Name="ChkAutoEngGuard" Content="{DynamicResource Loc.settings.behavior.autoeng}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    <CheckBox x:Name="ChkStopDeskflow" Content="{DynamicResource Loc.settings.behavior.stopdeskflow}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    <CheckBox x:Name="ChkDiagnostics" Content="{DynamicResource Loc.settings.behavior.diag}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
