<UserControl x:Class="OmniLink.Views.Settings.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Loc.settings.audio}" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
        <TextBlock Text="{DynamicResource Loc.settings.audio.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <CheckBox x:Name="ChkAutoStartStream" Content="{DynamicResource Loc.settings.audio.autostream}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    <CheckBox x:Name="ChkAutoStartMic" Content="{DynamicResource Loc.settings.audio.autommic}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    <CheckBox x:Name="ChkSmartAudioStandby" Content="{DynamicResource Loc.settings.audio.standby}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    <CheckBox x:Name="ChkSmartMicFocus" Content="{DynamicResource Loc.settings.audio.focusmic}" Style="{StaticResource SettingCheck}" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                </WrapPanel>

                <WrapPanel Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.audio.idle}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="AudioIdleTimeoutBox" Style="{StaticResource SettingBox}" TextChanged="OnBoxChanged"/>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.audio.idle.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="{DynamicResource Loc.settings.audio.micidle}" Style="{StaticResource SettingLabel}" Margin="0,0,8,0"/>
                        <TextBox x:Name="MicIdleTimeoutBox" Style="{StaticResource SettingBox}" TextChanged="OnBoxChanged"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="ErrorText" Style="{StaticResource SettingError}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
