<UserControl x:Class="OmniLink.Views.Settings.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource Loc.settings.clipboard}" FontSize="16" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
        <TextBlock Text="{DynamicResource Loc.settings.clipboard.desc}" Style="{StaticResource SettingDesc}" Margin="0,0,0,14"/>

        <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel Style="{StaticResource SettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="ChkClipboardSync" VerticalAlignment="Center" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.settings.clip.master.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.settings.clip.master.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{StaticResource SettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="ChkClipPush" VerticalAlignment="Center" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.clip.push.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.settings.clip.push.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.settings.clip.push.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{StaticResource SettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="ChkClipAccept" VerticalAlignment="Center" Checked="OnCheckChanged" Unchecked="OnCheckChanged"/>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.clip.accept.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.settings.clip.accept.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.settings.clip.accept.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <DockPanel Style="{StaticResource SettingRow}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox x:Name="ClipMaxBytesBox" Style="{StaticResource SettingBox}" TextChanged="OnBoxChanged"/>
                        <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.settings.clip.max.tip}">
                            <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.settings.clip.max.title}" Style="{StaticResource SettingTitle}"/>
                        <TextBlock Text="{DynamicResource Loc.settings.clip.max.desc}" Style="{StaticResource SettingDesc}" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="ErrorText" Style="{StaticResource SettingError}" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
