<Window x:Class="OmniLink.Views.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Border CornerRadius="10" Background="{DynamicResource FluentCardBrush}" BorderBrush="{DynamicResource FluentBorderSubtleBrush}" BorderThickness="1" Padding="20,16">
        <StackPanel>
            <TextBlock Text="{DynamicResource Loc.firstrun.title}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2"/>
            <TextBlock Text="{DynamicResource Loc.firstrun.subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>

            <Border CornerRadius="6" Padding="12,8" Background="{DynamicResource FluentCardDeepBrush}" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource Loc.firstrun.tip1}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </Border>
            <Border CornerRadius="6" Padding="12,8" Background="{DynamicResource FluentCardDeepBrush}" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource Loc.firstrun.tip2}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </Border>
            <Border CornerRadius="6" Padding="12,8" Background="{DynamicResource FluentCardDeepBrush}" Margin="0,0,0,6">
                <TextBlock Text="{DynamicResource Loc.firstrun.tip3}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </Border>
            <Border CornerRadius="6" Padding="12,8" Background="{DynamicResource FluentCardDeepBrush}" Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource Loc.firstrun.tip4}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </Border>

            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource Loc.firstrun.addnow}" Style="{StaticResource AppleSecondaryButton}" Padding="12,5" MinHeight="32" Margin="0,0,8,0" Click="OnAddNowClick"/>
                    <Button Content="{DynamicResource Loc.firstrun.ok}" Style="{StaticResource ApplePrimaryButton}" Padding="16,5" MinHeight="32" Click="OnOkClick"/>
                </StackPanel>
                <CheckBox x:Name="ChkDontShow" Content="{DynamicResource Loc.firstrun.dontshow}" IsChecked="True" VerticalAlignment="Center"
                          FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
