<Window x:Class="OmniLink.Views.ClipboardPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.picker.title}"
        Width="460" Height="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBgBrush}"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="4,2,4,8" Text="{DynamicResource Loc.picker.hint}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.7"/>
        <ListBox Grid.Row="1" x:Name="PickerList"
                 Background="Transparent"
                 BorderThickness="0"
                 MouseDoubleClick="OnItemActivate"
                 KeyDown="OnItemActivate">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,6" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.5" FontSize="11">
                                <Run Text="{Binding MimeType, Mode=OneWay}"/> ·
                                <Run Text="{Binding TimestampLocal, Mode=OneWay}"/> ·
                                <Run Text="{Binding SourceNodeId, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Margin="4,6,4,0" Text="{DynamicResource Loc.picker.footer}"
                   Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.5" FontSize="11"/>
    </Grid>
</Window>
