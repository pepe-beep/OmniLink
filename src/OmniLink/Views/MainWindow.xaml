<Window x:Class="OmniLink.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="OmniLink — Mesh KVM &amp; Two-Way Low-Latency Audio"
        Icon="pack://application:,,,/OmniLink;component/Assets/app.ico"
        Width="1120" Height="750" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Fluent TabItem Style (Clean Underline Indicator) -->
        <Style x:Key="FluentTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Cursor="Hand">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource FluentSubtleFillBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource FluentSubtleFillHoverBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource FluentAccentPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluent Card Border Style -->
        <Style x:Key="FluentCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FluentCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Resources>

    <!-- Main Application Frame (Calm Neutral Dark Slate) -->
    <Border x:Name="Root" Background="{StaticResource FluentCanvasBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= TOP MASTER BAR ================= -->
            <Border Grid.Row="0" x:Name="TopBannerCard" Style="{StaticResource FluentCardBorderStyle}" Padding="16,12" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">

                    <!-- Right: Keyboard-layout sync segment (ไม่ใช่ภาษา UI — ป้ายชัดตาม v1.9) + Quick Switch Hint -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.top.bar.kbd}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border CornerRadius="16" Padding="2" Margin="0,0,12,0"
                                Background="{StaticResource FluentSubtleFillBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}" BorderThickness="1"
                                ToolTip="{DynamicResource Loc.top.bar.kbd.tip}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnLangSegmentEn" Content="ENG" Padding="12,3" MinHeight="26"
                                        FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand"
                                        Click="OnCalibrateEnClick"/>
                                <Button x:Name="BtnLangSegmentTh" Content="ไทย" Padding="12,3" MinHeight="26"
                                        FontWeight="SemiBold" FontSize="11.5" BorderThickness="0" Cursor="Hand"
                                        Click="OnCalibrateThClick"/>
                            </StackPanel>
                        </Border>

                        <!-- Shortcut Keycap Badge -->
                        <Border CornerRadius="6" Padding="10,5" Background="{StaticResource FluentSubtleFillPressedBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}" BorderThickness="1"
                                ToolTip="{DynamicResource Loc.top.bar.kbd.tip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Keyboard24" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Win+Space / ~" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Left: Brand Logo, App Name, Status Banner -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0" Background="{StaticResource FluentCardDeepBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}" BorderThickness="1">
                            <Image x:Name="HeaderAppIcon" Width="26" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="OmniLink" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Border CornerRadius="12" Padding="8,2" Background="{StaticResource StatusOnlineBgBrush}" BorderBrush="{StaticResource StatusOnlineBrush}" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource StatusOnlineBrush}" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="StatusBannerText" Text="{DynamicResource Loc.status.boot}"
                                                   FontSize="11" Foreground="{StaticResource StatusOnlineBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Loc.app.subtitle}"
                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= MAIN TAB CONTROL ================= -->
            <TabControl Grid.Row="1" x:Name="MainTabs" BorderThickness="0" Background="Transparent" Cursor="Arrow">

                <!-- TAB 1: Control Topology & Spatial Canvas -->
                <TabItem Header="{DynamicResource Loc.tab.topology}" Style="{StaticResource FluentTabItemStyle}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="310" MinWidth="280"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*" MinWidth="580"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Connected Device Rack -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="2,0,0,8">
                                <ui:Button x:Name="BtnQuickScan" DockPanel.Dock="Right" Content="{DynamicResource Loc.devices.scan}"
                                           Appearance="Secondary" Icon="{ui:SymbolIcon Search24}"
                                           Padding="10,4" MinHeight="28" FontSize="11.5"
                                           Click="OnQuickScanClick"/>
                                <TextBlock Text="{DynamicResource Loc.devices.connected}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- Device List -->
                            <ListBox Grid.Row="1" x:Name="NodeListBox" HorizontalContentAlignment="Stretch"
                                     SelectionChanged="OnNodeSelectionChanged"
                                     PreviewMouseLeftButtonDown="OnNodeListBoxPreviewMouseDown"
                                     PreviewMouseMove="OnNodeListBoxPreviewMouseMove"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,3"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" CornerRadius="6" Padding="12,10"
                                                            Background="{StaticResource FluentCardBrush}"
                                                            BorderBrush="{StaticResource FluentBorderSubtleBrush}"
                                                            BorderThickness="1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource FluentCardHoverBrush}"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource FluentBorderHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource FluentCardSelectedBrush}"/>
                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource FluentAccentPrimaryBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel VerticalAlignment="Center">
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="36" Height="36"
                                                   Margin="0,0,10,0" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Border DockPanel.Dock="Right" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Background="{Binding StatusBadgeBg}">
                                                <TextBlock Text="{Binding StatusShort}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding StatusBadgeFg}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SubTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding TelemetryLine}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Node Actions — v1.9: header chip บอกชัดว่า "กำลังจัดการเครื่องไหน" -->
                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                <Border CornerRadius="6" Padding="10,6" Background="{StaticResource FluentSubtleFillPressedBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}" BorderThickness="1" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DesktopCursor24" FontSize="13" Foreground="{StaticResource FluentAccentLightBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{DynamicResource Loc.devices.target}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NodeTargetHeaderText" Text="{DynamicResource Loc.devices.target.none}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{StaticResource FluentAccentLightBrush}" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>

                                <ui:Button x:Name="BtnFocusSelectedNode" Content="{DynamicResource Loc.devices.switch}"
                                           Appearance="Primary" Icon="{ui:SymbolIcon DesktopCursor24}"
                                           Padding="12,8" MinHeight="36" FontWeight="SemiBold"
                                           HorizontalAlignment="Stretch" Click="OnJumpToSelectedNodeClick"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" x:Name="BtnRenameNode" Content="{DynamicResource Loc.devices.rename}"
                                               Appearance="Secondary" Icon="{ui:SymbolIcon Edit24}"
                                               Padding="4,6" MinHeight="32" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Stretch" Click="OnRenameNodeClick"/>
                                    <ui:Button Grid.Column="2" x:Name="BtnResetNodeName" Content="{DynamicResource Loc.devices.reset}"
                                               Appearance="Secondary" Icon="{ui:SymbolIcon ArrowReset24}"
                                               Padding="4,6" MinHeight="32" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Stretch" Click="OnResetNodeNameClick"/>
                                    <ui:Button Grid.Column="4" x:Name="BtnDeleteNode" Content="{DynamicResource Loc.devices.remove}"
                                               Appearance="Danger" Icon="{ui:SymbolIcon Delete24}"
                                               Padding="4,6" MinHeight="32" FontSize="11" FontWeight="SemiBold"
                                               HorizontalAlignment="Stretch" Click="OnDeleteNodeClick"/>
                                </Grid>

                                <!-- v1.9: ย้ายมาจาก popup Advanced — ประเภทเครื่องของ node ที่เลือก (ใต้ header chip ชัดเจน) -->
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource Loc.devices.devicetype}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="DeviceTypeCombo" MinHeight="32" FontSize="11.5" HorizontalAlignment="Stretch"
                                              ToolTip="{DynamicResource Loc.devices.devicetype.tip}" SelectionChanged="OnDeviceTypeChanged">
                                        <ComboBoxItem Content="{DynamicResource Loc.devtype.laptop}"/>
                                        <ComboBoxItem Content="{DynamicResource Loc.devtype.desktop}"/>
                                        <ComboBoxItem Content="{DynamicResource Loc.devtype.server}"/>
                                    </ComboBox>
                                </DockPanel>

                                <!-- v1.9.1: ต่อจากเครื่องไหน (anchor) — chain topology ต่อได้ไม่จำกัด -->
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock Text="{DynamicResource Loc.devices.anchor}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="AnchorCombo" MinHeight="32" FontSize="11.5" HorizontalAlignment="Stretch"
                                              ToolTip="{DynamicResource Loc.devices.anchor.tip}" SelectionChanged="OnAnchorChanged"/>
                                </DockPanel>

                                <!-- v1.9 C2: แม็ปปุ่ม modifier ต่อเครื่อง (แบบ Deskflow ComputerSettings) -->
                                <Expander Margin="0,8,0,0">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource Loc.devices.modmap}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource InfoIconButton}" ToolTip="{DynamicResource Loc.devices.modmap.tip}">
                                                <TextBlock Style="{StaticResource InfoIconGlyph}"/>
                                            </Button>
                                        </StackPanel>
                                    </Expander.Header>
                                    <Border CornerRadius="6" Padding="10,8" Background="{StaticResource FluentSubtleFillBrush}" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Loc.devices.modmap.desc}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                                    <TextBlock Text="{DynamicResource Loc.modmap.shift}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox x:Name="ModMapShift" Width="120" MinHeight="28" FontSize="11" SelectionChanged="OnModMapChanged"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                                    <TextBlock Text="{DynamicResource Loc.modmap.ctrl}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox x:Name="ModMapCtrl" Width="120" MinHeight="28" FontSize="11" SelectionChanged="OnModMapChanged"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                                    <TextBlock Text="{DynamicResource Loc.modmap.alt}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox x:Name="ModMapAlt" Width="120" MinHeight="28" FontSize="11" SelectionChanged="OnModMapChanged"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                                    <TextBlock Text="{DynamicResource Loc.modmap.super}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox x:Name="ModMapSuper" Width="120" MinHeight="28" FontSize="11" SelectionChanged="OnModMapChanged"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                                    <TextBlock Text="{DynamicResource Loc.modmap.altgr}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox x:Name="ModMapAltGr" Width="120" MinHeight="28" FontSize="11" SelectionChanged="OnModMapChanged"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Expander>

                                <ui:Button x:Name="BtnDeployAgents" Content="{DynamicResource Loc.devices.deploy}"
                                           Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}"
                                           Padding="12,8" MinHeight="34" Margin="0,6,0,0" FontWeight="SemiBold"
                                           ToolTip="{DynamicResource Loc.devices.deploy.tip}"
                                           HorizontalAlignment="Stretch" Click="OnDeployAgentsClick"/>

                                <!-- v1.7 Zone Model: capability ต่อ node -->
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="{DynamicResource Loc.devices.policy}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="NodePolicyCombo" MinHeight="32" FontSize="11.5" HorizontalAlignment="Stretch"
                                              SelectionChanged="OnNodePolicyChanged">
                                        <ComboBoxItem Content="{DynamicResource Loc.policy.full}"/>
                                        <ComboBoxItem Content="{DynamicResource Loc.policy.clipboard}"/>
                                        <ComboBoxItem Content="{DynamicResource Loc.policy.view}"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Right Column: Spatial Monitor Arrangement Canvas -->
                        <Grid Grid.Column="2">
                            <Border x:Name="ScreenMapCard" Style="{StaticResource FluentCardBorderStyle}" Padding="18,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Screen Arrangement Header -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc.map.activetopology}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="L440PositionCombo" Width="170" MinHeight="32" FontSize="12" VerticalContentAlignment="Center"
                                                      Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource FluentCardDeepBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}"
                                                      SelectionChanged="OnL440PositionChanged">
                                                <ComboBoxItem Content="{DynamicResource Loc.map.pos.right}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <ComboBoxItem Content="{DynamicResource Loc.map.pos.left}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <ComboBoxItem Content="{DynamicResource Loc.map.pos.top}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <ComboBoxItem Content="{DynamicResource Loc.map.pos.bottom}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc.map.title}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{DynamicResource Loc.map.desc}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Interactive 2D Spatial Screen Canvas (Deskflow-Superior Matrix) -->
                                    <!-- v1.9.1: ผัง topology ไดนามิก — ลูกศรรอบทุกเครื่อง = จุดวางเครื่องใหม่ (chain ได้ไม่จำกัด) -->
                                    <Grid Grid.Row="1" Margin="4,4" ClipToBounds="True" x:Name="MapHostGrid" Background="Transparent">
                                        <Canvas x:Name="TopologyCanvas" MinHeight="280" Background="Transparent"/>
                                        <ui:Button x:Name="BtnResetMapView" Content="{DynamicResource Loc.map.resetview}"
                                                   Appearance="Secondary" Padding="10,3" MinHeight="26" FontSize="10.5"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8"
                                                   ToolTip="{DynamicResource Loc.map.resetview.tip}" Click="OnResetMapViewClick"/>
                                    </Grid>

                                    <!-- Bottom Operational Info -->
                                    <Border Grid.Row="2" CornerRadius="6" Padding="12,8" Background="{StaticResource FluentSubtleFillBrush}" Margin="0,12,0,0">
                                        <DockPanel>
                                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Info24" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc.map.info}"
                                                       FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Two-Way Audio Matrix -->
                <TabItem Header="{DynamicResource Loc.tab.audio}" Style="{StaticResource FluentTabItemStyle}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" x:Name="AudioHubCard" Style="{StaticResource FluentCardBorderStyle}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc.audio.title}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Loc.audio.desc}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Dual Cards: Speaker Stream and Mic Bridge -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Speaker Stream Card (Remote -> Host) -->
                                    <Border Grid.Column="0" CornerRadius="8" Padding="16" Background="{StaticResource FluentCardDeepBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Speaker224" Foreground="{StaticResource FluentAccentLightBrush}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource Loc.audio.stream.title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <TextBlock Grid.Row="1" x:Name="StreamStatusLabel" Text="{DynamicResource Loc.audio.stream.ready}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                            <Border Grid.Row="2" CornerRadius="6" Padding="12" Background="{StaticResource FluentSubtleFillBrush}" VerticalAlignment="Top">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource Loc.audio.dest.label}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                    <TextBlock Text="{DynamicResource Loc.audio.dest.value}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{DynamicResource Loc.audio.dest.tech}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Grid.Row="3" x:Name="BtnToggleStream" Content="{DynamicResource Loc.audio.stream.start}" Style="{StaticResource ApplePrimaryButton}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="OnToggleStreamClick"/>
                                        </Grid>
                                    </Border>

                                    <!-- Mic Bridge Card (Host -> Remote) -->
                                    <Border Grid.Column="2" CornerRadius="8" Padding="16" Background="{StaticResource FluentCardDeepBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Mic24" Foreground="{StaticResource StatusOnlineBrush}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource Loc.audio.mic.title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <TextBlock Grid.Row="1" x:Name="MicStatusLabel" Text="{DynamicResource Loc.audio.mic.ready}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                                            <StackPanel Grid.Row="2">
                                                <DockPanel Margin="0,0,0,6">
                                                    <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Loc.common.refresh}" Appearance="Secondary" Padding="8,2" MinHeight="24" FontSize="10.5" Click="OnScanMicsClick"/>
                                                    <TextBlock Text="{DynamicResource Loc.audio.mic.label}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <ComboBox x:Name="MicDeviceCombo" MinHeight="32" FontSize="12" VerticalContentAlignment="Center"
                                                          Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource FluentCardBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}"
                                                          SelectionChanged="OnMicDeviceSelectionChanged"/>
                                                <TextBlock Text="{DynamicResource Loc.audio.mic.tech}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Row="3" x:Name="BtnToggleMic" Content="{DynamicResource Loc.audio.mic.start}" Style="{StaticResource AppleSecondaryButton}" HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="OnToggleMicClick"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Audio Reset Utility Bar -->
                        <Border Grid.Row="1" Style="{StaticResource FluentCardBorderStyle}" Padding="14,10" Margin="0,10,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{DynamicResource Loc.audio.reset}" Style="{StaticResource AppleSecondaryButton}" Padding="12,4" MinHeight="28" Click="OnResetBothAudioClick"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc.audio.trouble.title}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{DynamicResource Loc.audio.trouble.desc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3: Files & Clipboard Hub -->
                <TabItem Header="{DynamicResource Loc.tab.files}" Style="{StaticResource FluentTabItemStyle}">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Live File Transfer Progress Card -->
                        <Border Grid.Row="0" x:Name="FileTransferCard" Style="{StaticResource FluentCardBorderStyle}" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <ui:Button DockPanel.Dock="Right" x:Name="BtnOpenTransferFolder" Content="{DynamicResource Loc.files.openfolder}" Appearance="Secondary" Icon="{ui:SymbolIcon FolderOpen24}" Padding="10,4" MinHeight="26" FontSize="11" Visibility="Collapsed" Click="OnOpenTransferFolderClick"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{StaticResource FluentAccentLightBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Loc.files.title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <DockPanel Grid.Row="1" Margin="0,0,0,6">
                                    <TextBlock x:Name="FileTransferMetaText" DockPanel.Dock="Right" Text="{DynamicResource Loc.files.idle}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="FileTransferFileNameText" Text="{DynamicResource Loc.files.hint}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <ProgressBar Grid.Row="2" x:Name="FileTransferProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{StaticResource FluentAccentPrimaryBrush}" Background="{StaticResource FluentCardDeepBrush}" BorderThickness="0"/>
                            </Grid>
                        </Border>

                        <!-- Clipboard History List -->
                        <Border Grid.Row="1" Style="{StaticResource FluentCardBorderStyle}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ui:Button Content="{DynamicResource Loc.common.refresh}" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" Padding="10,4" MinHeight="28" FontSize="11.5" Margin="0,0,6,0" Click="OnRefreshClipboardHistoryClick"/>
                                        <ui:Button Content="{DynamicResource Loc.clip.clear}" Appearance="Secondary" Icon="{ui:SymbolIcon Delete24}" Padding="10,4" MinHeight="28" FontSize="11.5" Click="OnClearClipboardHistoryClick"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc.clip.title}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource Loc.clip.desc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </DockPanel>

                                <ListBox Grid.Row="1" ItemsSource="{Binding HistoryVM.Entries}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,3"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border CornerRadius="6" Padding="12,8" Background="{StaticResource FluentCardDeepBrush}" BorderBrush="{StaticResource FluentBorderSubtleBrush}" BorderThickness="1">
                                                            <ContentPresenter/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <ui:Button DockPanel.Dock="Right" Content="{DynamicResource Loc.clip.copy}" Appearance="Secondary" Padding="10,4" MinHeight="26" FontSize="11" Click="OnCopyHistoryItemClick" Tag="{Binding}"/>
                                                <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" Background="{StaticResource FluentSubtleFillBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MimeType}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource FluentAccentLightBrush}"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PreviewText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TimestampLocal, StringFormat='{}{0:HH:mm:ss}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 4: Settings — v1.9 rail + หน้าย่อย 9 หน้า (Advanced popup ถูกลบ ย้ายมาเป็นหน้าในแอป) -->
                <TabItem Header="{DynamicResource Loc.tab.settings}" Style="{StaticResource FluentTabItemStyle}">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" MinWidth="200"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*" MinWidth="560"/>
                        </Grid.ColumnDefinitions>

                        <!-- Section rail -->
                        <Border Grid.Column="0" Style="{StaticResource FluentCardBorderStyle}" Padding="8">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Loc.settings.rail.title}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,6,8,10"/>
                                <ListBox x:Name="SettingsSectionList" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseWheel="OnScrollViewerPreviewMouseWheel"
                                         SelectionChanged="OnSettingsSectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RailItemBorder" CornerRadius="6" Padding="10,8" Background="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RailItemBorder" Property="Background" Value="{StaticResource FluentCardHoverBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="RailItemBorder" Property="Background" Value="{StaticResource FluentCardSelectedBrush}"/>
                                                                <Setter TargetName="RailItemBorder" Property="BorderBrush" Value="{StaticResource FluentAccentPrimaryBrush}"/>
                                                                <Setter TargetName="RailItemBorder" Property="BorderThickness" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                           x:Name="RailItemText"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- Page host -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource FluentCardBorderStyle}" Padding="4,4,4,4">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="OnScrollViewerPreviewMouseWheel">
                                    <ContentControl x:Name="SettingsPageContent" Margin="12,8"/>
                                </ScrollViewer>
                            </Border>
                            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="BtnResetPage" Content="{DynamicResource Loc.settings.reset}"
                                            Style="{StaticResource AppleSecondaryButton}" Padding="14,5" MinHeight="30" Margin="0,0,6,0"
                                            IsEnabled="False" ToolTip="{DynamicResource Loc.settings.reset.tip}" Click="OnResetPageClick"/>
                                    <Button x:Name="BtnRestorePage" Content="{DynamicResource Loc.settings.restore}"
                                            Style="{StaticResource AppleSecondaryButton}" Padding="14,5" MinHeight="30"
                                            ToolTip="{DynamicResource Loc.settings.restore.tip}" Click="OnRestorePageClick"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Loc.settings.livehint}" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>
