<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- ═══ ธีม "ตามปัจจุบัน (น้ำเงินเข้ม)" — ค่าเดิมของแอปทุกประการ (v2.0 แยกออกจาก App.xaml เพื่อสลับธีมได้) ═══ -->

    <!-- 0. พื้นหลังหน้าต่างหลัก (หน้าต่างทึบ — ไม่มี backdrop/material แล้ว) -->
    <SolidColorBrush x:Key="AppWindowBgBrush" Color="#131722"/>

    <!-- 1. Neutral Surfaces & Backgrounds -->
    <SolidColorBrush x:Key="FluentCanvasBrush" Color="#1C1F26"/>
    <SolidColorBrush x:Key="FluentCardBrush" Color="#232936"/>
    <SolidColorBrush x:Key="FluentCardHoverBrush" Color="#2C3444"/>
    <SolidColorBrush x:Key="FluentCardSelectedBrush" Color="#1E3048"/>
    <SolidColorBrush x:Key="FluentCardDeepBrush" Color="#181C24"/>

    <!-- Fill จาง/แถบเลื่อน/จุดโฟกัส (v2.0 token แทน literal #xxFFFFFF ใน style) -->
    <SolidColorBrush x:Key="FluentSubtleFillBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="FluentSubtleFillHoverBrush" Color="#25FFFFFF"/>
    <SolidColorBrush x:Key="FluentSubtleFillPressedBrush" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="FluentFocusFillBrush" Color="#222834"/>
    <SolidColorBrush x:Key="FluentScrollbarThumbBrush" Color="#30FFFFFF"/>

    <!-- 2. Clean 1px Subtle Borders -->
    <SolidColorBrush x:Key="FluentBorderSubtleBrush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="FluentBorderHoverBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="FluentBorderFocusedBrush" Color="#0078D4"/>

    <!-- 3. Focused System Accent -->
    <SolidColorBrush x:Key="FluentAccentPrimaryBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="FluentAccentHoverBrush" Color="#1A86D9"/>
    <SolidColorBrush x:Key="FluentAccentPressedBrush" Color="#006CBE"/>
    <SolidColorBrush x:Key="FluentAccentLightBrush" Color="#4CC2FF"/>

    <!-- 4. Functional Semantic Status -->
    <SolidColorBrush x:Key="StatusOnlineBrush" Color="#27AE60"/>
    <SolidColorBrush x:Key="StatusOnlineBgBrush" Color="#1827AE60"/>
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#808080"/>
    <SolidColorBrush x:Key="StatusIdleBgBrush" Color="#18808080"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#18D97706"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#E11D48"/>
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#18E11D48"/>

    <!-- 5. Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#475569"/>

    <!-- Backward-Compatibility Aliases -->
    <SolidColorBrush x:Key="AeroGlassCanvasBrush" Color="#1C1F26"/>
    <SolidColorBrush x:Key="AeroGlassCardBrush" Color="#232936"/>
    <SolidColorBrush x:Key="AeroGlassCardHoverBrush" Color="#2C3444"/>
    <SolidColorBrush x:Key="AeroGlassCardDeepBrush" Color="#181C24"/>
    <SolidColorBrush x:Key="AeroSpecularRimBrush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="AeroSpecularRimHoverBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="AeroSubtleBorderBrush" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="AeroCyanBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AeroCyanDeepBrush" Color="#200078D4"/>
    <SolidColorBrush x:Key="AeroCyanGlowBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="JewelEmeraldBrush" Color="#27AE60"/>
    <SolidColorBrush x:Key="JewelEmeraldDeepBrush" Color="#2027AE60"/>
    <SolidColorBrush x:Key="JewelEmeraldGlowBrush" Color="#27AE60"/>
    <SolidColorBrush x:Key="JewelAmberBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="JewelAmberDeepBrush" Color="#20D97706"/>
    <SolidColorBrush x:Key="JewelRubyBrush" Color="#E11D48"/>
    <SolidColorBrush x:Key="JewelRubyDeepBrush" Color="#20E11D48"/>
    <SolidColorBrush x:Key="AppleTextWhite" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppleTextSlateLight" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AppleTextSlateMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="AppleCardBackground" Color="#232936"/>
    <SolidColorBrush x:Key="AppleCardBorder" Color="#20FFFFFF"/>
    <SolidColorBrush x:Key="AppleAccentBlue" Color="#0078D4"/>
    <SolidColorBrush x:Key="AppleAccentEmerald" Color="#27AE60"/>
    <SolidColorBrush x:Key="AppleAccentAmber" Color="#D97706"/>
    <SolidColorBrush x:Key="AppleAccentRed" Color="#E11D48"/>
</ResourceDictionary>
