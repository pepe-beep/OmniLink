<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>OmniLink.Platform.Windows</RootNamespace>
    <AssemblyName>OmniLink.Platform.Windows</AssemblyName>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniLink" />
    <InternalsVisibleTo Include="OmniLink.Tests" />
    <InternalsVisibleTo Include="OmniLink.XamlLoadHarness" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniLink.Core\OmniLink.Core.csproj" />
  </ItemGroup>

</Project>
