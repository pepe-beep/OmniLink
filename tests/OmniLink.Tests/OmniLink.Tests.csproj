    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="..\..\src\OmniLink\OmniLink.csproj" />
  </ItemGroup>

  <!-- หลาย test class bind port จริง (24801/24800) + แตะ static state (OmniPaths) —
       ห้ามรัน collection ขนานกัน (flake: Auth_WithWrongToken โดน server อีกตัวใน collection อื่น) -->
